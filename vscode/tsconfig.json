{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "vscode"
    ],
    "rootDir": "src",
    "moduleResolution": "bundler",
    "noEmit": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/test"
  ]
}
